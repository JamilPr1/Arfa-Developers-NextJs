# Google Search Console API (admin dashboard → Search Console tab)
# Paste the full service account JSON key file contents as a single line, or base64-encode it.
GSC_SERVICE_ACCOUNT_JSON=
# Must match the property URL in Search Console exactly (trailing slash optional).
GSC_SITE_URL=https://www.arfadevelopers.com/

# Public site URL (fallback for GSC if GSC_SITE_URL is unset)
NEXT_PUBLIC_SITE_URL=https://www.arfadevelopers.com

# ---------------------------------------------------------------------------
# Arfa AI Voice Assistant (embedded widget on the live site)
# Flow on Vercel / local:
#   1. Browser mic → /api/voice/process
#   2. STT: OpenAI whisper-1 (if audio blob sent)
#   3. Brain recall: prior Q&A from Upstash Redis (Vercel) or lib/data/arfa-brain.json (local)
#   4. Chat: gpt-4o-mini (override with OPENAI_CHAT_MODEL) + full page/product knowledge
#   5. Successful answers are saved back into the brain for next time
#   6. TTS: /api/voice/speak → OpenAI tts-1 (OPENAI_TTS_VOICE, default nova)
# Required on Vercel: OPENAI_API_KEY
# Recommended on Vercel for persistent brain: UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_TTS_VOICE=nova
OPENAI_CHAT_MODEL=gpt-4o-mini

# Link to AI products storefront (optional)
NEXT_PUBLIC_VOICE_AGENT_URL=http://localhost:3000
