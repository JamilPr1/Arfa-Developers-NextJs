# Google Search Console API (admin dashboard → Search Console tab)
# Paste the full service account JSON key file contents as a single line, or base64-encode it.
GSC_SERVICE_ACCOUNT_JSON=
# Must match the property URL in Search Console exactly (trailing slash optional).
GSC_SITE_URL=https://www.arfadevelopers.com/

# Public site URL (fallback for GSC if GSC_SITE_URL is unset)
NEXT_PUBLIC_SITE_URL=https://www.arfadevelopers.com

# Arfa AI Voice Assistant (OpenAI Whisper + GPT-4o-mini + TTS)
OPENAI_API_KEY=
OPENAI_TTS_VOICE=nova

# Link to AI products storefront (voice agent site)
NEXT_PUBLIC_VOICE_AGENT_URL=http://localhost:3000
